# Nightingale Tea Tourism - cPanel Environment Configuration
APP_ENV=production
# Leave APP_BASE_PATH empty if hosted on booking.nightingaletea.com
# Set APP_BASE_PATH=/booking if hosted in a subfolder nightingaletea.com/booking
APP_BASE_PATH=
PRIMARY_DOMAIN=https://nightingaletea.com

# MySQL Credentials from cPanel -> MySQL Databases
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cpaneluser_nightingale_booking
DB_USER=cpaneluser_nttadmin
DB_PASS=STRONG_RANDOM_PASSWORD

# Razorpay API Keys (Leave blank to operate Manual UPI only until KYC completes)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Company Direct UPI Details (0% Transaction Fee)
MERCHANT_UPI_ID=nightingaletea@icici
MERCHANT_UPI_NAME="Nightingale Tea Tourism"

# Concurrency & Caching Settings
HOLD_TTL_MINUTES=30
CACHE_TTL_SECONDS=45
CRON_SECRET=replace_with_32_char_random_secret
